# ─────────────────────────────────────────────────────────────
# Wholesale AI v2 — environment
# Copy to .env and fill in. Any value left blank = dry-run mode
# (nothing is sent, everything is logged as "simulated" so you
#  can test the whole pipeline before spending a cent).
# ─────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------
APP_ENV=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DATABASE_URL=sqlite:///./data/wholesale.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname   # Railway provides this

# --- Bootstrap admin (created on first boot) ----------------
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Your Name

# --- Your identity used in outreach copy --------------------
AGENT_NAME=Your Name
AGENT_COMPANY=Your Company
AGENT_PHONE=+15125550100
AGENT_EMAIL=you@yourdomain.com
AGENT_CALENDAR_LINK=https://cal.com/you/intro

# Where "a seller wants to talk" alerts are sent. Messages to YOU, not the lead.
# Defaults to AGENT_PHONE / AGENT_EMAIL when left blank.
OWNER_ALERT_SMS=
OWNER_ALERT_EMAIL=
# CAN-SPAM requires a real physical postal address in every marketing email.
AGENT_POSTAL_ADDRESS=1234 Main St, Suite 200, Dallas, TX 75201

# --- Telnyx (voice + SMS) -----------------------------------
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=+15125550100
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# --- Email (SMTP or Resend) ---------------------------------
EMAIL_PROVIDER=resend          # resend | smtp | (blank = dry-run)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=offers@yourdomain.com

# --- Markets -------------------------------------------------
# States the pipeline works. Adding a state is safe: quiet hours, timezones
# and DNC are already per-state, and SMS stays inbound-only everywhere.
MARKET_STATES=TX
# Optional per-state cities: "TX:Dallas,Houston;FL:Tampa,Orlando"
MARKET_CITIES=
# Your public seller landing page (served by this app at /sell)
PUBLIC_FORM_URL=https://your-app.up.railway.app/sell

# --- Lead data providers ------------------------------------
# demo | csv | batchdata
LEAD_PROVIDER=demo
BATCHDATA_API_KEY=

# --- DNC scrubbing ------------------------------------------
# live | demo | off
DNC_PROVIDER=demo
DNC_API_KEY=

# --- Compliance ---------------------------------------------
# Federal quiet hours are 8am-9pm recipient local time.
# Stricter states are enforced automatically (see app/compliance.py)
ENFORCE_QUIET_HOURS=true
MAX_SMS_PER_LEAD_PER_DAY=1
MAX_CALL_ATTEMPTS_PER_LEAD_PER_WEEK=3
