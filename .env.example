# ══════════════════════════════════════════════════════════════
# Wholesale AI — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-32-chars
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Database ─────────────────────────────────────────────────
# SQLite (default, free):
DATABASE_URL=sqlite:///wholesale.db

# PostgreSQL (Supabase, optional):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Telnyx (SMS) ~$0.004/msg — half the price of Twilio ──────
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_PHONE_NUMBER=+14696990385
TELNYX_MESSAGING_PROFILE_ID=4001a152-9e3d-4967-a3e4-a1e94061e2ba

# ── Vapi (Voice AI) ~$0.05/min ───────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER=+1XXXXXXXXXX

# ── Email (SMTP — use Gmail App Password) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Email Verification (free 100/day) ────────────────────────
QUICKEMAIL_API_KEY=

# ── Contract / Buyer Info ────────────────────────────────────
BUYER_NAME=Your Name
BUYER_ENTITY=Your LLC Name
BUYER_PHONE=+1XXXXXXXXXX
BUYER_EMAIL=your-email@gmail.com

# ── JV Partners ──────────────────────────────────────────────
# Primary: MaxDispo (fee-on-top model — you keep 100% of your fee)
JV_PARTNER_EMAIL=support@maxdispo.com
JV_PARTNER_NAME=MaxDispo
JV_PARTNER_PHONE=18557347476

# Backup: Cash Home Investors (60/40 split — you keep 60%)
JV_BACKUP_EMAIL=info@cashhomeinvestors.com
JV_BACKUP_NAME=Cash Home Investors
JV_BACKUP_PHONE=5125882771
