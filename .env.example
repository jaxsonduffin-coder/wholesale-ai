# ══════════════════════════════════════════════════════════════
# Wholesale AI — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-32-chars
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Database ─────────────────────────────────────────────────
# SQLite (default, free):
DATABASE_URL=sqlite:///wholesale.db

# PostgreSQL (Supabase, optional):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Twilio (SMS) ~$0.0079/msg ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Vapi (Voice AI) ~$0.05/min ───────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER=+1XXXXXXXXXX

# ── Email (SMTP — use Gmail App Password) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Email Verification (free 100/day) ────────────────────────
QUICKEMAIL_API_KEY=

# ── Contract / Buyer Info ────────────────────────────────────
BUYER_NAME=Your Name
BUYER_ENTITY=Your LLC Name
BUYER_PHONE=+1XXXXXXXXXX
BUYER_EMAIL=your-email@gmail.com

# ── JV Partner ───────────────────────────────────────────────
JV_PARTNER_EMAIL=partner@example.com
JV_PARTNER_NAME=Partner Name
